---
// The one layout. Everything a crawler reads about a page — title,
// description, canonical, robots — arrives as a prop, and robots always
// comes from policy(): this file renders a decision, it never makes one.
import "../styles/global.css";
import { site } from "../site.config.ts";
import Icon from "../components/Icon.astro";
import type { Robots } from "../lib/types.ts";

interface Props {
  /** The page's own part of the title; the suffix is added here. */
  title?: string;
  /** A complete title, for the one page that names the site itself. */
  fullTitle?: string;
  description: string;
  robots: Robots;
  /** Canonical path, e.g. "/feed/example/". Defaults to the request path. */
  path?: string;
  jsonLd?: object | object[];
  /** A feed a reader app can discover from this page. */
  alternate?: { href: string; title: string; type?: string };
  ogType?: string;
}

const { title, fullTitle, description, robots, jsonLd, alternate, ogType = "website" } = Astro.props;
const path = Astro.props.path ?? Astro.url.pathname;
const canonical = new URL(path, site.url).toString();
const pageTitle = fullTitle ?? (title ? `${title} · ${site.titleSuffix}` : site.titleSuffix);
const current = Astro.url.pathname;
const isCurrent = (href: string) => (href === "/" ? current === "/" : current.startsWith(href));
const onTab = (t: { href: string; match: readonly string[] }) => isCurrent(t.href) || t.match.some((m) => current.startsWith(m));
// Same-origin pages are fetched ahead the moment a finger lands on a link
// (or the pointer rests on one), so the next screen opens the way an app's
// does. Never the API, the outbound hop, edit pages or the XML files.
const speculation = {
  prefetch: [
    {
      where: { and: [{ href_matches: "/*" }, { not: { href_matches: ["/api/*", "/go/*", "/*/edit/*", "/*.xml", "/*.txt"] } }] },
      eagerness: "moderate",
    },
  ],
};
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141210" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {alternate && <link rel="alternate" type={alternate.type ?? "application/rss+xml"} href={alternate.href} title={alternate.title} />}
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o).replace(/</g, "\\u003c")} />)}
    <script type="speculationrules" is:inline set:html={JSON.stringify(speculation)} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/" title={`${site.titleSuffix}: find and follow ${site.keyword}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><rect width="24" height="24" rx="6" fill="currentColor"></rect><circle cx="7" cy="17" r="2" fill="var(--surface)"></circle><path
              fill="var(--surface)"
              d="M5 10a9 9 0 0 1 9 9h-2.5A6.5 6.5 0 0 0 5 12.5zM5 5a14 14 0 0 1 14 14h-2.5A11.5 11.5 0 0 0 5 7.5z"></path></svg
          >
          <span class="wordmark-name">{site.name}</span>
        </a>
        <nav class="nav-row" aria-label="Main">
          <ul class="nav">
            {
              site.nav.map((n) => (
                <li>
                  <a href={n.href} title={n.title} aria-current={isCurrent(n.href) ? "page" : undefined}>
                    <Icon name={n.icon} />
                    <span>{n.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        {/* On a phone the row gives way to the tab bar along the bottom, and
            this menu keeps what the tabs leave out. A native <details>: it
            opens and closes with no script, and says "expanded" to a screen
            reader by itself; the script below only adds closing on an outside
            tap or Escape. */}
        <details class="menu">
          <summary aria-label="Menu">
            <span class="burger" aria-hidden="true"></span>
          </summary>
          <div class="menu-panel">
            <form class="menu-search" action="/search/" method="get" role="search">
              <label class="visually-hidden" for="menu-q">Search RSS feeds</label>
              <input id="menu-q" name="q" type="search" placeholder="Search RSS feeds…" autocomplete="off" enterkeyhint="search" />
              <button class="button icon-only" type="submit" aria-label="Search" title="Search RSS feeds">
                <Icon name="search" />
              </button>
            </form>
            <nav aria-label="More">
              <ul>
                {
                  site.menu.map((n) => (
                    <li>
                      <a href={n.href} title={n.title} aria-current={isCurrent(n.href) ? "page" : undefined}>
                        <Icon name={n.icon} />
                        <span>{n.label}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
          </div>
        </details>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <ul>
          {
            site.footer.map((n) => (
              <li>
                <a href={n.href} title={n.title}>
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
        <p>{site.name} — a directory of {site.keyword}, readable on a phone. Excerpts belong to their publishers; every entry links to its source.</p>
      </div>
    </footer>
    <nav class="tabbar" aria-label="Sections">
      <ul>
        {
          site.tabs.map((t) => (
            <li>
              <a href={t.href} title={t.title} aria-current={onTab(t) ? "page" : undefined}>
                <Icon name={t.icon} />
                <span>{t.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <script>
      import { track } from "../scripts/track.ts";
      track("view");

      // <details> closes only on its own summary. A menu should also close
      // on a tap outside it (the dimmed page) and on Escape.
      const menu = document.querySelector<HTMLDetailsElement>(".menu");
      if (menu) {
        document.addEventListener("click", (e) => {
          if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
        });
        document.addEventListener("keydown", (e) => {
          if (e.key !== "Escape" || !menu.open) return;
          menu.open = false;
          menu.querySelector("summary")?.focus();
        });
      }

      // With the keyboard up the tab bar would ride on top of it and eat
      // half of what is left of the screen; it steps aside while typing.
      const typing = (el: EventTarget | null) =>
        el instanceof HTMLTextAreaElement || (el instanceof HTMLInputElement && !["checkbox", "radio", "button", "submit"].includes(el.type));
      document.addEventListener("focusin", (e) => document.documentElement.classList.toggle("typing", typing(e.target)));
      document.addEventListener("focusout", () => document.documentElement.classList.remove("typing"));
    </script>
  </body>
</html>
