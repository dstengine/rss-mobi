---
// A list of posts. Each links to its original, marked the way policy()
// says: a followed link when we stand in for an original the index has
// not seen, ugc otherwise. The date links to the post's own page, the way
// a blog's permalink does, but only while that page is open to search:
// the rest are stand-ins nobody needs, and linking them would spend a
// crawler's visits on noindex pages.
import { linkTo } from "../lib/policy.ts";
import { fmtDate, itemPageOpen, itemPath, type PublicItem } from "../lib/views.ts";
import type { FeedDoc } from "../lib/types.ts";

interface Props {
  items: PublicItem[];
  feed?: Pick<FeedDoc, "linkMode">;
  /** Show which feed each post came from (tag pages mix feeds). */
  showFeed?: boolean;
}
const { items, feed, showFeed = false } = Astro.props;
---

<ol class="items">
  {
    items.map((it) => {
      const link = linkTo(it, feed);
      return (
        <li>
          <h3>
            {link.mode === "none" ? (
              it.title
            ) : (
              <a href={it.url} rel={link.rel ?? undefined} title={`Read “${it.title}” on ${it.host}`} data-outbound>
                {it.title}
              </a>
            )}
          </h3>
          <span class="meta">
            {itemPageOpen(it) ? (
              <a href={itemPath(it.id)} title={`“${it.title}”: the post in the RSS feeds directory`}>
                <time datetime={new Date(it.publishedAt).toISOString()}>{fmtDate(it.publishedAt)}</time>
              </a>
            ) : (
              <time datetime={new Date(it.publishedAt).toISOString()}>{fmtDate(it.publishedAt)}</time>
            )}
            {" · "}
            {showFeed ? (
              <a href={`/feed/${it.feedSlug}/`} title={`The ${it.host} RSS feed`}>
                {it.host}
              </a>
            ) : (
              it.host
            )}
            {it.author && ` · ${it.author}`}
          </span>
          {it.excerpt && it.excerpt !== it.title && <p>{it.excerpt}</p>}
        </li>
      );
    })
  }
</ol>
<script>
  import { track } from "../scripts/track.ts";
  document.addEventListener("click", (e) => {
    const a = (e.target as Element | null)?.closest?.("a[data-outbound]") as HTMLAnchorElement | null;
    if (a) track("outbound", { label: a.hostname });
  });
</script>
