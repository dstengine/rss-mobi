---
// A feed's icon: its site's own, or its initial on a tile, served from
// /feed/<slug>/icon (lib/icon.ts). Always an image, never a broken one.
interface Props {
  slug: string;
  /** Pixels on screen: 40 in lists, 56 on the feed's page. */
  size?: number;
  /** Above the fold: load at once rather than lazily. */
  eager?: boolean;
}
const { slug, size = 40, eager = false } = Astro.props;
---

<span class="favicon" aria-hidden="true">
  <img src={`/feed/${slug}/icon`} alt="" width={size} height={size} loading={eager ? "eager" : "lazy"} decoding="async" />
</span>
