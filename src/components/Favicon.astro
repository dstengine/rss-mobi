---
// The feed's own image when it has a usable one, its initial otherwise.
import { safeImage } from "../lib/views.ts";

interface Props {
  title: string;
  image?: string;
}
const { title, image } = Astro.props;
const src = safeImage(image);
const initial = (title.match(/[\p{L}\p{N}]/u)?.[0] ?? "#").toUpperCase();
---

<span class="favicon" aria-hidden="true">
  {src ? <img src={src} alt="" width="40" height="40" loading="lazy" decoding="async" referrerpolicy="no-referrer" /> : initial}
</span>
