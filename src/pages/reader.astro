---
// The reader. What it shows depends on this browser's list of followed
// feeds, which lives in localStorage — so the server renders one page for
// everyone (the tool, a starter set of feeds, how it works) and the script
// fills in the rest. A crawler sees exactly what a first-time visitor sees.
import Base from "../layouts/Base.astro";
import FeedCard from "../components/FeedCard.astro";
import FollowButton from "../components/FollowButton.astro";
import { site } from "../site.config.ts";
import { policy } from "../lib/policy.ts";
import { cacheFor } from "../lib/http.ts";
import { recentFeeds } from "../lib/views.ts";
import Icon from "../components/Icon.astro";

const starters = await recentFeeds(8);
const decision = policy({ type: "static" });
Astro.response.headers.set("Cache-Control", cacheFor(300));

const description = "A free RSS reader for your phone: follow RSS feeds from the directory, read the newest posts in one list, import and export OPML. No account.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: `${site.name} reader`,
  url: `${site.url}/reader/`,
  description,
  applicationCategory: "NewsApplication",
  operatingSystem: "Any",
  browserRequirements: "A web browser",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Base title="Read RSS feeds on your phone" description={description} robots={decision.robots} path="/reader/" jsonLd={jsonLd}>
  <h1>Read RSS feeds on your phone</h1>
  <p class="lede">Follow feeds from the directory and read their newest posts in one list. Your list stays on this device — no account, nothing to sign up for.</p>

  <div class="tabs" role="tablist" aria-label="Reader">
    <button type="button" role="tab" id="tab-latest" aria-controls="panel-latest" aria-selected="true">Latest</button>
    <button type="button" role="tab" id="tab-following" aria-controls="panel-following" aria-selected="false" tabindex="-1">
      Following <span class="n" id="sub-count"></span>
    </button>
  </div>

  <section id="panel-latest" role="tabpanel" aria-labelledby="tab-latest">
    <div id="reading" hidden>
      <div class="chips" id="chips" role="group" aria-label="Show one feed"></div>
      <ol class="items" id="items" aria-live="polite"></ol>
      <p class="muted" id="reader-state" role="status"></p>
      <p><button type="button" class="button secondary" id="more" hidden>Load more</button></p>
    </div>

    <div id="empty">
      <div class="notice" id="empty-note">
        <p>
          You are not following any feeds yet. Tap <strong>Follow</strong> on a few below, or on any feed's page, and their posts collect here. Already
          use a reader? <button type="button" class="linklike" data-goto="following">Import your OPML file</button>.
        </p>
      </div>
      {
        starters.length > 0 && (
          <>
            <h2>Start with these RSS feeds</h2>
            <ul class="cards">
              {starters.map((f) => (
                <FeedCard feed={f}>
                  <FollowButton feed={f} class="button secondary" />
                </FeedCard>
              ))}
            </ul>
          </>
        )
      }
      <p><a href="/tags/" title="Browse RSS feeds by topic to find more to follow">Browse all topics</a></p>
    </div>
  </section>

  <section id="panel-following" role="tabpanel" aria-labelledby="tab-following" hidden>
    <ul class="sub-list" id="sub-list"></ul>
    <p class="muted" id="no-subs">Nothing followed yet.</p>

    <div class="actions" id="sub-actions" hidden>
      <button type="button" class="button secondary" id="export"><Icon name="export" /><span>Export OPML</span></button>
      <a class="button secondary" id="combine" href="/c/new/" title="Turn the feeds you follow into one RSS feed with its own address"><Icon name="combine" /><span>Combine into one feed</span></a>
    </div>

    <h2>Import from another reader</h2>
    <p class="small muted">Export an OPML file from Feedly, Inoreader, NetNewsWire or any other reader, then choose it here. Feeds already in the directory are followed at once.</p>
    <label for="opml">OPML file</label>
    <input id="opml" type="file" accept=".opml,.xml,text/xml,text/x-opml,application/xml" />
    <div id="import-result" class="notice" role="status" hidden></div>
  </section>

  {/* One post, whole, over the list: the way a reader app opens a post.
      Filled by the script from /api/v1/items/<id>/content, which reads the
      original feed; nothing of it is in the page a crawler sees. */}
  <dialog class="post-view" id="post" aria-labelledby="post-title">
    <div class="post-bar">
      <button type="button" class="post-close" id="post-close" aria-label="Back to the list" title="Back to the list"><Icon name="back" /></button>
      <span class="post-source" id="post-source"></span>
      <a class="button secondary small" id="post-open" target="_blank"><Icon name="external" /><span>Open</span></a>
    </div>
    <article class="post-body">
      <h2 id="post-title" tabindex="-1" autofocus></h2>
      <p class="meta" id="post-meta"></p>
      <div class="post-media" id="post-media"></div>
      <div class="post-content" id="post-content"></div>
      <p class="muted small" id="post-state" role="status"></p>
      <p class="post-end"><a class="button" id="post-end" target="_blank"></a></p>
    </article>
  </dialog>

  <section class="prose">
    <h2>How this RSS reader works</h2>
    <ul>
      <li>Following a feed adds it to a list kept in this browser. Nothing is sent to us but the list of feeds to fetch, and nothing identifies you.</li>
      <li>Posts arrive as the directory checks the feeds you read: hourly, and every 15 minutes for feeds that post several times a day. Tap a title to read the whole post here, pictures and audio included, as its feed carries it; <strong>Open</strong> takes you to the publisher's site.</li>
      <li>To move your list to another phone or another app, export it as OPML — the file every reader imports.</li>
      <li>On a phone, use your browser's <em>Add to Home Screen</em> to open the reader like an app. It works offline too: with no signal it opens with the posts it loaded last, and the posts you opened.</li>
    </ul>
  </section>
</Base>

<script>
  import { track } from "../scripts/track.ts";
  import { follow, lastSeen, markSeen, subs, unfollow, MAX_SUBS, type Sub } from "../scripts/subs.ts";
  import { counted } from "../lib/words.ts";
  import { parseOpml, toOpml } from "../lib/opml.ts";

  interface Item {
    id: string;
    feed: string;
    title: string;
    url: string;
    host: string;
    excerpt: string;
    thumbnail: string | null;
    author: string | null;
    publishedAt: string;
    link: { mode: string; rel: string | null };
  }

  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, props: Partial<HTMLElementTagNameMap[K]> = {}, ...kids: (Node | string)[]) => {
    const e = Object.assign(document.createElement(tag), props);
    e.append(...kids);
    return e;
  };
  /** A feed's icon, as every list on the site shows it (/feed/<slug>/icon).
      `loading` goes before `src`: an image starts loading the moment it
      has an address, in the DOM or not. */
  const icon = (slug: string, size: number) =>
    el("img", { loading: "lazy", decoding: "async", className: "src-icon", alt: "", width: size, height: size, src: `/feed/${slug}/icon` });

  const nowrap = (text: string) => el("span", { className: "nowrap" }, text);
  const date = (s: string) => new Intl.DateTimeFormat(undefined, { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" }).format(new Date(s));

  /* ------------------------------------------------------------ tabs */

  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[role=tab]")];
  function show(which: "latest" | "following") {
    for (const t of tabs) {
      const on = t.id === `tab-${which}`;
      t.setAttribute("aria-selected", String(on));
      t.tabIndex = on ? 0 : -1;
      $(`#${t.getAttribute("aria-controls")}`).hidden = !on;
    }
  }
  for (const t of tabs) t.addEventListener("click", () => show(t.id === "tab-latest" ? "latest" : "following"));
  for (const b of document.querySelectorAll<HTMLElement>("[data-goto]")) b.addEventListener("click", () => show(b.dataset.goto as "following"));

  /* ---------------------------------------------------------- reading */

  let only: string | null = null;
  let next: string | null = null;
  let seen = lastSeen();
  let newest = 0;
  // Each first-page load gets a number; an answer that arrives after a
  // newer request was made is dropped, so following two feeds in quick
  // succession shows both rather than whichever answered last.
  let generation = 0;
  // Set when the list on screen is a kept copy (public/sw.js): coming back
  // online brings the real one.
  let saved = false;

  function itemNode(it: Item, names: Map<string, string>) {
    // The title opens the post here. It stays a real link to the original
    // where the owner allows one, so a long press or a modified click
    // still reaches the publisher.
    const title =
      it.link.mode === "none"
        ? el("button", { type: "button", className: "linklike" }, it.title)
        : el("a", { href: it.url, title: `Read “${it.title}” from ${it.host}` }, it.title);
    if (title instanceof HTMLAnchorElement && it.link.rel) title.rel = it.link.rel;
    const open = (e: Event) => {
      const me = e as MouseEvent;
      if (me.metaKey || me.ctrlKey || me.shiftKey || me.altKey || me.button > 0) return track("outbound", { label: it.host });
      e.preventDefault();
      openPost(it, names.get(it.feed) ?? it.host, title);
    };
    title.addEventListener("click", open);
    // The post's picture opens it too. It repeats the title's link, so it
    // stays out of the tab order and of what a screen reader reads. The
    // API gives its address on rss.mobi; the path works on any host.
    const pic = it.thumbnail && new URL(it.thumbnail, location.href).pathname;
    let thumb: HTMLElement | null = null;
    if (pic) {
      const img = el("img", { loading: "lazy", decoding: "async", alt: "", width: 84, height: 84, src: pic });
      thumb = it.link.mode === "none" ? el("span", { className: "thumb" }, img) : el("a", { className: "thumb", href: it.url, tabIndex: -1 }, img);
      if (thumb instanceof HTMLAnchorElement && it.link.rel) thumb.rel = it.link.rel;
      thumb.setAttribute("aria-hidden", "true");
      thumb.addEventListener("click", open);
    }
    const at = new Date(it.publishedAt).getTime();
    const meta = el(
      "span",
      { className: "meta" },
      el("time", { dateTime: it.publishedAt, className: "nowrap" }, date(it.publishedAt)),
      " · ",
      el("a", { href: `/feed/${it.feed}/`, title: `The ${names.get(it.feed) ?? it.host} RSS feed` }, icon(it.feed, 16), names.get(it.feed) ?? it.host),
      it.author ? ` · ${it.author}` : "",
    );
    const li = el("li", {}, ...(thumb ? [thumb] : []), el("h3", {}, title), meta);
    if (seen && at > seen) li.prepend(el("span", { className: "new" }, "New"));
    if (it.excerpt && it.excerpt !== it.title) li.append(el("p", {}, it.excerpt));
    return li;
  }

  async function load(url: string, replace: boolean) {
    const mine = replace ? ++generation : generation;
    const state = $("#reader-state");
    const more = $<HTMLButtonElement>("#more");
    state.textContent = replace ? "Loading…" : "";
    more.disabled = true;
    try {
      const res = await fetch(url);
      if (!res.ok) throw new Error(String(res.status));
      const data: { items: Item[]; next: string | null } = await res.json();
      if (mine !== generation) return;
      const copy = res.headers.get("x-saved-copy");
      if (replace) saved = copy !== null;
      const names = new Map(subs().map((s) => [s.slug, s.title]));
      const list = $("#items");
      if (replace) list.replaceChildren();
      list.append(...data.items.map((it) => itemNode(it, names)));
      for (const it of data.items) newest = Math.max(newest, new Date(it.publishedAt).getTime());
      next = data.next;
      more.hidden = !next;
      state.textContent =
        copy !== null
          ? `Offline: these are the posts as of ${copy ? date(copy) : "your last visit"}.`
          : list.childElementCount
            ? ""
            : "No posts yet from the feeds you follow. They are checked at least once an hour.";
      if (!replace) track("reader_more");
    } catch {
      if (mine === generation) state.textContent = "Posts could not be loaded. Check your connection and try again.";
    } finally {
      if (mine === generation) more.disabled = false;
    }
  }

  function firstPage() {
    const list = subs();
    const slugs = only ? [only] : list.map((s) => s.slug).sort();
    const url = `/api/v1/items?${new URLSearchParams({ feed: slugs.join(","), limit: "30" })}`;
    return load(url, true).then(() => {
      // Posts newer than this visit's newest are "new" next time, not now.
      if (!only && newest) markSeen(newest);
    });
  }

  function chips(list: Sub[]) {
    const box = $("#chips");
    const chip = (label: string, slug: string | null) => {
      const b = el("button", { type: "button", className: "chip" }, ...(slug ? [icon(slug, 18)] : []), label);
      b.setAttribute("aria-pressed", String(only === slug));
      b.addEventListener("click", () => {
        only = slug;
        chips(subs());
        firstPage();
      });
      return b;
    };
    box.replaceChildren(chip("All", null), ...list.map((s) => chip(s.title, s.slug)));
    box.hidden = list.length < 2;
  }

  $("#more").addEventListener("click", () => next && load(next, false));

  /* --------------------------------------------------------- one post */

  const view = $<HTMLDialogElement>("#post");
  const content = $("#post-content");
  const media = $("#post-media");
  const postState = $("#post-state");
  let reading: string | null = null;
  let returnTo: HTMLElement | null = null;

  async function openPost(it: Item, feedName: string, from: HTMLElement) {
    reading = it.id;
    returnTo = from;
    $("#post-source").replaceChildren(icon(it.feed, 20), feedName);
    $("#post-title").textContent = it.title;
    $("#post-meta").replaceChildren(
      el("time", { dateTime: it.publishedAt, className: "nowrap" }, date(it.publishedAt)),
      it.author ? ` · ${it.author}` : "",
      " · ",
      el("a", { href: `/feed/${it.feed}/`, title: `The ${feedName} RSS feed` }, feedName),
    );
    // The way to the original follows the owner's link choice, as the list does.
    const linked = it.link.mode !== "none";
    for (const a of [$<HTMLAnchorElement>("#post-open"), $<HTMLAnchorElement>("#post-end")]) {
      a.hidden = !linked;
      a.href = it.url;
      a.rel = [it.link.rel, "noopener"].filter(Boolean).join(" ");
      a.title = `Read “${it.title}” on ${it.host}`;
    }
    $("#post-end").textContent = `Read on ${it.host}`;
    media.replaceChildren();
    content.replaceChildren(...(it.excerpt ? [el("p", {}, it.excerpt)] : []));
    postState.textContent = "Loading the whole post…";
    view.showModal();
    view.scrollTop = 0;
    // The phone's back gesture should close the post, not leave the reader.
    if (!history.state?.post) history.pushState({ post: it.id }, "", `#post-${it.id}`);
    track("read_post", { label: it.host });
    try {
      const res = await fetch(`/api/v1/items/${it.id}/content`);
      const data: { content: string | null; media: { url: string; type: string }[] } = await res.json();
      if (reading !== it.id) return;
      media.replaceChildren(
        ...(data.media ?? []).map((m) =>
          m.type.startsWith("video/")
            ? el("video", { src: m.url, controls: true, preload: "none", playsInline: true })
            : el("audio", { src: m.url, controls: true, preload: "none" }),
        ),
      );
      // Cleaned on the server by an allowlist (lib/feeds/clean.ts).
      if (data.content) {
        content.innerHTML = data.content;
        // A picture's title is text a mouse finds by hovering and a finger
        // never does — on xkcd it is half the joke. It goes under the
        // picture instead.
        for (const img of content.querySelectorAll<HTMLImageElement>("img[title]")) {
          if (img.closest("figure") || img.title.trim().length < 4) continue;
          const holder = img.closest("a") ?? img;
          holder.after(el("span", { className: "caption" }, img.title));
        }
      }
      postState.textContent = data.content ? "" : `Only the excerpt is here. The whole post is on ${it.host}.`;
    } catch {
      if (reading === it.id) postState.textContent = `The whole post could not be loaded. It is on ${it.host}.`;
    }
  }

  function closePost() {
    if (history.state?.post) history.back();
    else view.close();
  }

  $("#post-close").addEventListener("click", closePost);
  $("#post-open").addEventListener("click", () => track("outbound", { label: new URL($<HTMLAnchorElement>("#post-open").href).host }));
  $("#post-end").addEventListener("click", () => track("outbound", { label: new URL($<HTMLAnchorElement>("#post-end").href).host }));
  // Escape: go back the same way the button does, so history stays in step.
  view.addEventListener("cancel", (e) => {
    e.preventDefault();
    closePost();
  });
  // A click on the dimmed page around the post (wide screens) closes it.
  view.addEventListener("click", (e) => e.target === view && closePost());
  window.addEventListener("popstate", () => {
    if (view.open && !history.state?.post) view.close();
  });
  view.addEventListener("close", () => {
    reading = null;
    // Stop an episode that was playing, and free the post's pictures.
    content.replaceChildren();
    media.replaceChildren();
    returnTo?.focus();
  });
  // A post left open when the page was reloaded is not reopened: the list
  // it belongs to is gone.
  if (location.hash.startsWith("#post-")) history.replaceState(null, "", location.pathname + location.search);

  /* -------------------------------------------------------- following */

  function following(list: Sub[]) {
    $("#sub-count").textContent = list.length ? String(list.length) : "";
    $("#no-subs").hidden = list.length > 0;
    $("#sub-actions").hidden = list.length === 0;
    $<HTMLAnchorElement>("#combine").href = `/c/new/?${new URLSearchParams({ feeds: list.map((s) => s.slug).join(",") })}`;
    $("#sub-list").replaceChildren(
      ...list.map((s) => {
        const b = el("button", { type: "button", className: "button secondary small", title: `Stop following ${s.title}` }, "Unfollow");
        b.addEventListener("click", () => {
          unfollow(s.slug);
          track("unfollow");
        });
        return el(
          "li",
          {},
          el("span", { className: "favicon" }, icon(s.slug, 32)),
          el("span", {}, el("a", { href: `/feed/${s.slug}/`, title: `The ${s.title} RSS feed and its latest posts` }, s.title), el("span", { className: "meta" }, s.host)),
          b,
        );
      }),
    );
  }

  $("#export").addEventListener("click", () => {
    const xml = toOpml("Feeds followed on rss.mobi", subs().map((s) => ({ title: s.title, url: s.url })));
    const a = el("a", { href: URL.createObjectURL(new Blob([xml], { type: "text/x-opml" })), download: "rss-mobi-following.opml" });
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 10_000);
    track("opml_export");
  });

  $<HTMLInputElement>("#opml").addEventListener("change", async (e) => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    const box = $("#import-result");
    if (!file) return;
    box.hidden = false;
    box.className = "notice";
    box.textContent = "Reading the file…";
    const feeds = parseOpml(await file.text());
    if (!feeds.length) {
      box.className = "notice bad";
      box.textContent = "No feeds found in that file. Is it an OPML export?";
      return;
    }
    const found: Sub[] = [];
    const missing: string[] = [];
    try {
      for (let i = 0; i < feeds.length && i < 1_000; i += 200) {
        const res = await fetch("/api/v1/lookup", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ urls: feeds.slice(i, i + 200).map((f) => f.url) }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);
        for (const f of data.found) found.push({ slug: f.feed.slug, title: f.feed.title, host: f.feed.host, url: f.feed.url });
        missing.push(...data.missing);
      }
    } catch (err) {
      box.className = "notice bad";
      box.textContent = (err as Error).message || "The file could not be checked against the directory. Try again.";
      return;
    }
    const added = follow(...found);
    track("opml_import", { label: `${found.length}/${feeds.length}` });
    box.className = "notice ok";
    const full = subs().length >= MAX_SUBS ? [" The reader holds up to ", nowrap(counted(MAX_SUBS, "feed")), "."] : [];
    box.replaceChildren(el("p", {}, nowrap(counted(feeds.length, "feed")), ` in the file: ${found.length} in the directory, ${added} newly followed.`, ...full));
    if (missing.length) {
      const titles = new Map(feeds.map((f) => [f.url, f.title]));
      box.append(
        el("p", {}, missing.length === 1 ? "1 is not in the directory yet. Add it and it can be followed here too:" : `${missing.length} are not in the directory yet. Add them and they can be followed here too:`),
        el(
          "ul",
          { className: "missing" },
          ...missing.slice(0, 50).map((u) =>
            el(
              "li",
              {},
              el("a", { href: `/submit/?${new URLSearchParams({ url: u })}`, title: `Submit ${titles.get(u) ?? u} to the directory of RSS feeds` }, titles.get(u) ?? u),
            ),
          ),
        ),
      );
    }
    input.value = "";
  });

  /* ------------------------------------------------------------ start */

  // Someone who arrives with nothing followed keeps the starter feeds in
  // view for the whole visit, so following three of them takes three taps
  // rather than a hunt for where the list went after the first.
  const startedEmpty = subs().length === 0;

  function render() {
    const list = subs();
    if (only && !list.some((s) => s.slug === only)) only = null;
    $("#empty").hidden = list.length > 0 && !startedEmpty;
    $("#empty-note").hidden = list.length > 0;
    $("#reading").hidden = list.length === 0;
    following(list);
    if (list.length) {
      chips(list);
      firstPage();
    }
  }

  window.addEventListener("online", () => saved && subs().length && firstPage());
  window.addEventListener("rssmobi:subs", render);
  window.addEventListener("storage", (e) => e.key === "rssmobi:subs" && render());
  if (location.hash === "#following") show("following");
  render();

  // Offline, the reader opens with what it loaded last (public/sw.js).
  // Registered once the page is up, so it never competes with it.
  const keep = () => navigator.serviceWorker?.register("/sw.js", { scope: "/reader/" }).catch(() => {});
  if (document.readyState === "complete") keep();
  else window.addEventListener("load", keep);
</script>
