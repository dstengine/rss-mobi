---
import Base from "../layouts/Base.astro";
import { policy } from "../lib/policy.ts";

Astro.response.status = 404;
---

<Base title="Page not found" description="This page is not in the rss.mobi directory of RSS feeds." robots={policy({ type: "search" }).robots}>
  <h1>Not here</h1>
  <p>Nothing lives at this address. The feed may have been renamed, or the link may be mistyped.</p>
  <div class="actions">
    <a class="button" href="/" title="RSS feeds directory: newest feeds">Browse the directory</a>
    <a class="button secondary" href="/search/" title="Search RSS feeds">Search feeds</a>
  </div>
</Base>
