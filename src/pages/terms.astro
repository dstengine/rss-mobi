---
import Base from "../layouts/Base.astro";
import { site } from "../site.config.ts";
import { policy } from "../lib/policy.ts";
import { cacheFor } from "../lib/http.ts";

const decision = policy({ type: "static" });
Astro.response.headers.set("Cache-Control", cacheFor(3600));
---

<Base
  title="Terms"
  description="Terms for the rss.mobi directory of RSS feeds: what submitting a feed allows, what is shown from it, and how to ask for a feed to be removed."
  robots={decision.robots}
  path="/terms/"
>
  <div class="prose">
    <h1>Terms of the RSS feeds directory</h1>
    <p class="muted small">Last changed 23 September 2026.</p>

    <h2>Submitting a feed</h2>
    <p>
      A feed is a public document its publisher puts out so that other software can read it. Submitting one here means you believe it is public
      and meant to be read that way. You do not need to own the site, and nobody is asked to prove that they do.
    </p>

    <h2>What is shown from a feed</h2>
    <p>
      What a feed reader shows: the feed's name and description, and for each post its title, a short excerpt, its date, its author when given,
      and a link to the original. Full texts are not copied. rss.mobi may also publish its own articles that draw on several sources; every such
      article names and links the sources it used.
    </p>

    <h2>What is removed</h2>
    <p>
      Spam, scams, gambling, adult and pharmacy feeds, feeds that exist to sell links, and anything unlawful. A feed can be hidden and a site
      blocked without notice.
    </p>

    <h2>Removal on request</h2>
    <p>
      A publisher who does not want to be listed can ask for removal from the feed's page (<strong>Report a problem → I own this site</strong>),
      and whoever submitted the feed can take it down with their edit link.{site.contact && <> Anything else: <a href={`mailto:${site.contact}`} title={`Write to ${site.contact}`}>{site.contact}</a>.</>}
    </p>

    <h2>No warranty</h2>
    <p>
      The directory is provided as it is. Feeds and posts belong to their publishers, who are responsible for them; rss.mobi does not check what
      they say.
    </p>

    <h2>Privacy</h2>
    <p>
      No account, no cookies and no advertising trackers. Page views and clicks are counted without any identifier. When two versions of a page
      are being compared, a random number kept in your browser decides which one you see; it never leaves the browser. The directory keeps no
      addresses of people who submit feeds, only a hash that changes daily, to stop one address submitting hundreds.
    </p>
  </div>
</Base>
