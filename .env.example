# Copy to .env and fill in. Never commit .env.
# Production values live in Vercel env and GitHub secrets; scripts/sync-secrets.sh
# pushes them from this file without printing them.

MONGODB_CONNECTION_STRING=
MONGODB_DB=rssmobi

# Upstash Redis (injected by the Vercel Marketplace integration in production)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Upstash QStash, which calls the cron routes on schedule (ADR 0007). The
# integration sets these in Vercel; locally they are only needed to run
# scripts/qstash-schedules.mjs.
QSTASH_URL=
QSTASH_TOKEN=

# Shared secret the GitHub Actions scheduler sends to /api/v1/cron/*
CRON_SECRET=

# IndexNow key, served at /<key>.txt
INDEXNOW_KEY=

# Alerts (sendMessage only; no webhook is set on this bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Index checks of other sites' posts (paid; capped by LIMITS.serp)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# rss.mobi's own Search Console: the rss-mobi-workers service account's
# JSON key, base64 (scripts/gsc.mjs set-key writes it)
GSC_SERVICE_ACCOUNT=

# Backups (GitHub Actions and scripts/backup-pull.mjs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rss-mobi-backups
AGE_PUBLIC_KEY=

# v1.1
ANTHROPIC_API_KEY=
