# Copy to .env and fill in. Never commit .env.
# Production values live in Vercel env and GitHub secrets; scripts/sync-secrets.sh
# pushes them from this file without printing them.

MONGODB_CONNECTION_STRING=
MONGODB_DB=rssmobi

# Shared secret the schedulers send to /api/v1/cron/*: Vercel Cron reads it
# from the project's env (ADR 0008), the GitHub Actions fallback from its
# secrets
CRON_SECRET=

# IndexNow key, served at /<key>.txt
INDEXNOW_KEY=

# Alerts (sendMessage only; no webhook is set on this bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Index checks of other sites' posts (paid; capped by LIMITS.serp)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# rss.mobi's own Search Console: the rss-mobi-workers service account's
# JSON key, base64 (scripts/gsc.mjs set-key writes it)
GSC_SERVICE_ACCOUNT=

# Backups (GitHub Actions and scripts/backup-pull.mjs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rss-mobi-backups
AGE_PUBLIC_KEY=

# Paid API keys, sold through Polar (ADR 0010). The site needs only the
# public organisation id, the environment and the checkout link to show;
# the access tokens are for scripts/polar-setup.mjs alone.
POLAR_ORGANIZATION_ID=
POLAR_ENV=production
POLAR_KEY_PREFIX=RSSMOBI
POLAR_CHECKOUT_URL=
POLAR_ACCESS_TOKEN=
POLAR_SANDBOX_ACCESS_TOKEN=

# v1.1 — the Claude API for the stories. Loaded by `node --env-file=.env`
# only: never export it in a shell, where Claude Code would pick it up and
# bill the API credits, which do not cover Claude Code.
ANTHROPIC_API_KEY=
